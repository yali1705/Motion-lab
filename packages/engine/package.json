{
  "name": "@motion-lab/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic animation engine shared by the Motion Lab editor preview and the Remotion renderer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "node scripts/embed-fonts.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node scripts/embed-fonts.mjs && vitest run",
    "typecheck": "node scripts/embed-fonts.mjs && tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "vitest": "^3.2.0"
  }
}
