{
  "name": "@motion-lab/render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motion Lab render service: Remotion + FFmpeg cloud rendering with persistent jobs. Also serves the built editor.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json && node dist/bundle.js",
    "bundle": "node dist/bundle.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@motion-lab/engine": "*",
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.536",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0"
  }
}
